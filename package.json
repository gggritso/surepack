{
  "name": "surepack",
  "version": "0.3.0",
  "description": "Packing list generator",
  "keywords": [
    "cli",
    "packing",
    "travel"
  ],
  "homepage": "https://github.com/gggritso/surepack#readme",
  "bugs": {
    "url": "https://github.com/gggritso/surepack/issues"
  },
  "license": "ISC",
  "author": "George Gritsouk <989898+gggritso@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gggritso/surepack.git"
  },
  "bin": {
    "surepack": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm clean && tsc --project tsconfig.build.json",
    "watch": "tsc --project tsconfig.build.json --watch",
    "lint": "oxlint --deny-warnings --import-plugin --node-plugin --vitest-plugin .",
    "lint:fix": "pnpm lint --fix",
    "format:check": "oxfmt --check .",
    "format": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@inquirer/core": "^11.2.1",
    "@inquirer/prompts": "^8.7.1",
    "date-fns": "^4.4.0",
    "pluralize": "^8.0.0",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pluralize": "^0.0.33",
    "@types/yargs": "^17.0.35",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=23.5.0"
  },
  "volta": {
    "node": "24.12.0",
    "pnpm": "9.15.9"
  },
  "packageManager": "pnpm@9.15.9"
}
